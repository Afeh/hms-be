  "info": {
    "description": "HMS backend. Every response uses the four-key envelope.",
    "title": "HMS API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "operationId": "live_api_v1_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "$ref": "#/components/schemas/LiveHealth"
                  },
                  "title": "Response Live Api V1 Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "$ref": "#/components/schemas/ReadyHealth"
                  },
                  "title": "Response Ready Api V1 Health Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/tenant": {
      "get": {
        "description": "Return the calling tenant's profile.\n\nThe tenant ID comes from the verified request context (set by authentication\nmiddleware or by ``run_as_system`` in tests).  A missing context means the\nrequest was not authenticated and returns 401.",
        "operationId": "tenant_profile_api_v1_tenant_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "$ref": "#/components/schemas/TenantProfileResponse"
                  },
                  "title": "Response Tenant Profile Api V1 Tenant Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Tenant Profile",
        "tags": [
          "tenant"
        ]
      }
    },
    "/api/v1/tenant/config": {
      "get": {
        "description": "Return the effective tenant configuration.\n\nWorks even when no config document exists (defaults are returned).\nSets an ``ETag`` header with the config version for optimistic concurrency.",
        "operationId": "get_tenant_config_api_v1_tenant_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "$ref": "#/components/schemas/TenantConfigResponse"
                  },
                  "title": "Response Get Tenant Config Api V1 Tenant Config Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Tenant Config",
        "tags": [
          "tenant-config"
        ]
      },
      "patch": {
        "description": "Apply a partial update to the tenant configuration.\n\nRequires ``If-Match: \"<version>\"`` for optimistic concurrency.\nReturns ``412 version_mismatch`` for a stale version.\nReturns ``422 validation_failed`` for an invalid patch.",
        "operationId": "patch_tenant_config_api_v1_tenant_config_patch",
        "parameters": [
          {
            "in": "header",
            "name": "if-match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-Match"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TenantConfigPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "$ref": "#/components/schemas/TenantConfigResponse"
                  },
                  "title": "Response Patch Tenant Config Api V1 Tenant Config Patch",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Patch Tenant Config",
        "tags": [
          "tenant-config"
        ]
      }
    }
  }
}
