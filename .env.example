# Copy to .env. Every value has a working local default in app/core/config.py.
ENVIRONMENT=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# MongoDB must run as a replica set: transactions are required.
# Uses the project-local instance on 27018 (see README); the MongoDB Windows
# service on 27017 is standalone unless it was configured with --replSet.
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0
MONGODB_DATABASE=hms

REDIS_URL=redis://localhost:6379/0

# Cloudflare R2. The bucket stays private; the API issues short-lived presigned
# upload/download URLs. Leave these empty to boot without attachment support.
# STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_BUCKET=hms-documents
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
STORAGE_REGION=auto
STORAGE_PRESIGN_TTL_SECONDS=300
STORAGE_MAX_IMAGE_BYTES=10485760

# Authentication. Local defaults are development-only; staging and production
# refuse to start unless both values are random and at least 32 characters.
# JWT_SECRET=
# MFA_SECRET_KEY=

# Browser auth cookies. Login sets HttpOnly access and refresh cookies alongside
# the JSON token pair. Secure cookies default on outside ENVIRONMENT=local.
# AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=
# Celery falls back to REDIS_URL when these are unset.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# Comma-separated list, or a JSON array.
CORS_ORIGINS=http://localhost:3000
