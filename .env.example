# Copy to .env. Every value has a working local default in app/core/config.py.
ENVIRONMENT=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# MongoDB must run as a replica set: transactions are required.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DATABASE=hms

REDIS_URL=redis://localhost:6379/0
# Celery falls back to REDIS_URL when these are unset.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# Comma-separated list, or a JSON array.
CORS_ORIGINS=http://localhost:3000
