# Copy to .env. Every value has a working local default in app/core/config.py.
ENVIRONMENT=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# MongoDB must run as a replica set: transactions are required.
# Uses the project-local instance on 27018 (see README); the MongoDB Windows
# service on 27017 is standalone unless it was configured with --replSet.
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0
MONGODB_DATABASE=hms

REDIS_URL=redis://localhost:6379/0

# Authentication. Local defaults are development-only; staging and production
# refuse to start unless both values are random and at least 32 characters.
# JWT_SECRET=
# MFA_SECRET_KEY=
# Celery falls back to REDIS_URL when these are unset.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# Comma-separated list, or a JSON array.
CORS_ORIGINS=http://localhost:3000
